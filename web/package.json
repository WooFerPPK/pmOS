{
  "name": "pmos-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PMos browser-side bootstrap + drivers + service worker",
  "scripts": {
    "build:bootstrap": "esbuild src/bootstrap.ts --bundle --outfile=../build/assets/bootstrap.js --format=esm",
    "build:sw": "esbuild src/sw.ts --bundle --outfile=../build/sw.js --format=esm",
    "build": "npm run build:bootstrap && npm run build:sw",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "playwright test tests/integration"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^20.11.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
